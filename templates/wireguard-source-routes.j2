#!/bin/sh
set -eu

ACTION="${1:-}"
WG_INTERFACE="${2:-}"

TABLE="{{ wireguard_source_routing_table }}"
PRIORITY="{{ wireguard_source_routing_priority }}"
LAN_INTERFACE="{{ wireguard_source_routing_lan_interface }}"
GATEWAY="{{ wireguard_source_routing_gateway }}"
STATE_ROOT="/run/wireguard-source-routes"
STATE_DIR="${STATE_ROOT}/table-${TABLE}"
STATE_FILE="${STATE_DIR}/${WG_INTERFACE}"

REMOTE_SUBNETS="$(cat <<'EOF'
{% for subnet in wireguard_source_routing_remote_subnets %}
{{ subnet }}
{% endfor %}
EOF
)"

if [ "$ACTION" != "up" ] && [ "$ACTION" != "down" ]; then
  echo "usage: $0 up|down <wireguard-interface>" >&2
  exit 64
fi

if [ -z "$WG_INTERFACE" ]; then
  echo "missing WireGuard interface name" >&2
  exit 64
fi

case "$WG_INTERFACE" in
  *[!A-Za-z0-9_.:-]*)
    echo "invalid WireGuard interface name: ${WG_INTERFACE}" >&2
    exit 64
    ;;
esac

lan_source_ip() {
  ip -4 -o addr show dev "$LAN_INTERFACE" scope global | awk 'NR == 1 { split($4, addr, "/"); print addr[1] }'
}

rule_exists() {
  subnet="$1"
  priority="$2"
  table="$3"
  ip -4 rule show | awk \
    -v priority="${priority}:" \
    -v subnet="$subnet" \
    -v table="$table" \
    '$1 == priority && $2 == "from" && $3 == subnet && $(NF - 1) == "lookup" && $NF == table { found = 1 } END { exit !found }'
}

add_rule() {
  subnet="$1"
  priority="$2"
  table="$3"

  if ! rule_exists "$subnet" "$priority" "$table"; then
    ip -4 rule add priority "$priority" from "$subnet" table "$table"
  fi
}

current_rules() {
  index=0
  for subnet in $REMOTE_SUBNETS; do
    echo "$TABLE $((PRIORITY + index)) $subnet $GATEWAY $LAN_INTERFACE"
    index="$((index + 1))"
  done
}

delete_rule() {
  subnet="$1"
  priority="$2"
  table="$3"

  while rule_exists "$subnet" "$priority" "$table"; do
    ip -4 rule delete priority "$priority" from "$subnet" table "$table"
  done
}

rollback_up() {
  current_rules | while read -r table priority subnet gateway lan_interface; do
    delete_rule "$subnet" "$priority" "$table"
    ip -4 route delete default via "$gateway" dev "$lan_interface" table "$table" 2>/dev/null || true
  done
  rm -f "$STATE_FILE"
  ip -4 route flush cache 2>/dev/null || true
}

any_active_state() {
  [ -d "$STATE_ROOT" ] && find "$STATE_ROOT" -type f -print -quit 2>/dev/null | grep -q .
}

case "$ACTION" in
  up)
    trap rollback_up EXIT HUP INT TERM

    SRC_IP="$(lan_source_ip)"
    if [ -z "$SRC_IP" ]; then
      echo "could not determine IPv4 source address for ${LAN_INTERFACE}" >&2
      exit 1
    fi

    mkdir -p "$STATE_DIR"
    ip -4 route replace default via "$GATEWAY" dev "$LAN_INTERFACE" src "$SRC_IP" table "$TABLE"

    current_rules | while read -r table priority subnet gateway lan_interface; do
      add_rule "$subnet" "$priority" "$table"
    done

    current_rules > "$STATE_FILE"
    trap - EXIT HUP INT TERM
    ;;
  down)
    rules_file="$(mktemp)"

    if [ -d "$STATE_ROOT" ]; then
      find "$STATE_ROOT" -type f -name "$WG_INTERFACE" -print 2>/dev/null | while read -r state_file; do
        cat "$state_file" >> "$rules_file"
        rm -f "$state_file"
      done
    fi

    if [ ! -s "$rules_file" ]; then
      current_rules > "$rules_file"
    fi

    if any_active_state; then
      ip -4 route flush cache 2>/dev/null || true
      rm -f "$rules_file"
      exit 0
    fi

    while read -r table priority subnet gateway lan_interface; do
      delete_rule "$subnet" "$priority" "$table"
      ip -4 route delete default via "$gateway" dev "$lan_interface" table "$table" 2>/dev/null || true
    done < "$rules_file"

    rm -f "$rules_file"
    ;;
esac

ip -4 route flush cache 2>/dev/null || true
