[Interface]
Address = {{ wireguard_server_listen_ip }}
ListenPort = {{ wireguard_server_listen_port }}
PrivateKey = {{ wireguard_server_private_key }}
{% if wireguard_source_routing_enabled | bool %}
PostUp = {{ wireguard_source_routing_script }} up
PostDown = {{ wireguard_source_routing_script }} down
{% endif %}

{% for ip, pubkey in wireguard_server_clients.items() %}
{% if 'Key' not in ip %}
[Peer]
PublicKey = {{ pubkey }}
AllowedIPs = {{ ip }}{% if ip in wireguard_ip_map %}, {{wireguard_ip_map[ip]}}

{% else %}

{% endif %}
PersistentKeepalive = 29
{% endif %}
{% endfor %}
